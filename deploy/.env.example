# jadabot deployment secrets — copy to .env and fill in. NEVER commit .env.

# Timezone for containers
TZ=UTC

# ---- LLM Manager (the only place provider keys live) ----
JADABOT_DEFAULT_MODEL=gpt-4o-mini
JADABOT_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
JADABOT_PROVIDER_OPENAI_API_KEY=
# Optional comma-separated allow-list of models this provider serves
JADABOT_PROVIDER_OPENAI_MODELS=

# ---- Mem0 ----
# Gateway token issued for the memory service (see docs/runbooks.md)
JADABOT_MEM0_GATEWAY_TOKEN=
