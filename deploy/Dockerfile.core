# jadabot core services image (LLM Manager, Runtime Manager library)
FROM python:3.12-slim

WORKDIR /app
COPY core/pyproject.toml core/README.md ./
COPY core/jadabot ./jadabot
RUN pip install --no-cache-dir .

EXPOSE 8100
CMD ["uvicorn", "jadabot.llm.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8100"]
