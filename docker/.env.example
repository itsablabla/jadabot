# jadabot memory stack configuration. Copy to .env and fill in real values.
# Never commit the .env file.

# --- Mem0 server -> central LLM gateway routing ---
# OpenAI-compatible endpoint of jadabot's central LLM manager
JADABOT_LLM_GATEWAY_URL=http://jadabot-core:5300/v1
# Internal gateway key for the Mem0 usage category (issued by jadabot core)
JADABOT_LLM_GATEWAY_MEM0_KEY=

# --- Mem0 vector store (pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- jadabot core memory subsystem ---
# Base URL where the Mem0 server is reachable from jadabot core
JADABOT_MEM0_URL=http://mem0:8000
# Optional Mem0 API key (self-hosted auth, or Mem0 cloud platform key when
# using the managed alternative instead of the self-hosted server)
JADABOT_MEM0_API_KEY=
# HMAC secret used to sign per-bot runtime memory tokens
JADABOT_MEMORY_TOKEN_SECRET=
# Admin bearer key protecting the memory admin API (web panel)
JADABOT_MEMORY_ADMIN_KEY=
